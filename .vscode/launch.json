{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run C# Inline Launch Pad",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/testPyramid"
      ],
      "env": {
        "CSHARP_LAUNCHPAD_LOG": "${workspaceFolder}/.devlog/launchpad.log"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
